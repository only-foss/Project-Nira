# Analysis scripts — force Octave detection
*.m linguist-language=Octave
*.m linguist-detectable=true

# Firmware — force Arduino detection  
*.ino linguist-language=Arduino
*.ino linguist-detectable=true

# Hardware — make KiCad files detectable
*.kicad_sch linguist-language=KiCad
*.kicad_sch linguist-detectable=true
*.kicad_pcb linguist-language=KiCad
*.kicad_pcb linguist-detectable=true
*.kicad_sym linguist-language=KiCad
*.kicad_sym linguist-detectable=true

# Hide truly non-code files only
*.pdf linguist-vendored=true
*.zip linguist-vendored=true
*.png linguist-vendored=true
*.jpg linguist-vendored=true
*.jpeg linguist-vendored=true
*.step linguist-vendored=true
*.csv linguist-vendored=true
